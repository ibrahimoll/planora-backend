DATABASE_URL=postgresql://username:password@localhost:5432/planora_db

JWT_SECRET_CODE=your_jwt_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=30

VERIFICATION_CODE_SECRET=your_verification_code_secret_here
VERIFICATION_CODE_EXPIRE_MINUTES=10

PASSWORD_RESET_CODE_SECRET=your_password_reset_secret_here
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com

GOOGLE_CLIENT_ID=your_google_client_id_here

AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15

# CORS / Frontend origins
# Comma-separated list. Do not use * with credentials/auth headers.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500
CORS_ALLOW_CREDENTIALS=true